  "sessions": [
    {
      "session_id": "os-02-01",
      "name": "进程与线程",
      "created_at": "2026-03-05T19:11:00+08:00",
      "updated_at": "2026-03-05T19:37:00+08:00",
      "course": "OS",
      "tags": [
        "进程",
        "线程"
      ],
      "messages": [
        {
          "role": "user",
          "text": "进程和线程的本质区别是什么？",
          "timestamp": "2026-03-05T19:11:00+08:00"
        },
        {
          "role": "assistant",
          "text": "进程是资源分配单位，拥有独立地址空间；线程是调度单位，共享所属进程的资源。线程切换更轻，但共享内存会带来同步问题。",
          "timestamp": "2026-03-05T19:13:00+08:00"
        },
        {
          "role": "user",
          "text": "能结合一个具体场景解释吗？",
          "timestamp": "2026-03-05T19:14:00+08:00"
        },
        {
          "role": "assistant",
          "text": "可以。围绕「进程与线程」，一个直观的场景是：浏览器用多进程隔离标签页，标签页内部再用多线程处理渲染与网络。",
          "timestamp": "2026-03-05T19:17:00+08:00"
        },
        {
          "role": "user",
          "text": "这里最容易出错的地方是什么？",
          "timestamp": "2026-03-05T19:18:00+08:00"
        },
        {
          "role": "assistant",
          "text": "最常见的坑是：认为线程一定更快。线程共享地址空间，错误会互相影响，CPU 密集任务还受核数限制。",
          "timestamp": "2026-03-05T19:22:00+08:00"
        },
        {
          "role": "user",
          "text": "考试里如果换一种问法，我该怎么判断？",
          "timestamp": "2026-03-05T19:23:00+08:00"
        },
        {
          "role": "assistant",
          "text": "先定位题目问的是调度、同步还是内存：调度题画甘特图；同步题写信号量初值与 P/V 顺序；内存题先画页表再算地址。 当题干关键词落在「进程与线程」上时，先写出对象、约束和目标，再套方法。",
          "timestamp": "2026-03-05T19:25:00+08:00"
        },
        {
          "role": "user",
          "text": "用一句话帮我记住它。",
          "timestamp": "2026-03-05T19:26:00+08:00"
        },
        {
          "role": "assistant",
          "text": "一句话：进程隔离资源，线程共享资源。",
          "timestamp": "2026-03-05T19:29:00+08:00"
        },
        {
          "role": "user",
          "text": "它和哪个知识点最容易混淆？",
          "timestamp": "2026-03-05T19:30:00+08:00"
        },
        {
          "role": "assistant",
          "text": "最容易混淆的是「协程与用户态调度」。区分时先问：讨论的是存储结构、执行过程还是评价指标？",
          "timestamp": "2026-03-05T19:34:00+08:00"
        },
        {
          "role": "user",
          "text": "如果放到真实项目里，这个知识点的价值在哪？",
          "timestamp": "2026-03-05T19:35:00+08:00"
        },
        {
          "role": "assistant",
          "text": "Web 服务用连接池和并发模型处理大量请求。",
          "timestamp": "2026-03-05T19:37:00+08:00"
        }
      ]
    },
    {
      "session_id": "os-02-02",
      "name": "进程调度",
      "created_at": "2026-04-09T20:18:00+08:00",
      "updated_at": "2026-04-09T20:44:00+08:00",
      "course": "OS",
      "tags": [
        "调度",
        "FCFS"
      ],
      "messages": [
        {
          "role": "user",
          "text": "先来先服务、短作业优先和时间片轮转各适合什么场景？",
          "timestamp": "2026-04-09T20:18:00+08:00"
        },
        {
          "role": "assistant",
          "text": "FCFS 简单但长作业会拖累短作业；SJF 平均等待时间短，但需要预知运行时间且可能饿死长作业；RR 用时间片保证响应性，适合交互系统。",
          "timestamp": "2026-04-09T20:20:00+08:00"
        },
        {
          "role": "user",
          "text": "能结合一个具体场景解释吗？",
          "timestamp": "2026-04-09T20:21:00+08:00"
        },
        {
          "role": "assistant",
          "text": "可以。围绕「进程调度」，一个直观的场景是：给定三个作业的到达与运行时间，画甘特图并计算平均周转时间。",
          "timestamp": "2026-04-09T20:24:00+08:00"
        },
        {
          "role": "user",
          "text": "这里最容易出错的地方是什么？",
          "timestamp": "2026-04-09T20:25:00+08:00"
        },
        {
          "role": "assistant",
          "text": "最常见的坑是：把响应时间和周转时间混为一谈。响应时间是从提交到首次运行，周转时间是从提交到完成。",
          "timestamp": "2026-04-09T20:29:00+08:00"
        },
        {
          "role": "user",
          "text": "考试里如果换一种问法，我该怎么判断？",
          "timestamp": "2026-04-09T20:30:00+08:00"
        },
        {
          "role": "assistant",
          "text": "先定位题目问的是调度、同步还是内存：调度题画甘特图；同步题写信号量初值与 P/V 顺序；内存题先画页表再算地址。 当题干关键词落在「进程调度」上时，先写出对象、约束和目标，再套方法。",
          "timestamp": "2026-04-09T20:32:00+08:00"
        },
        {
          "role": "user",
          "text": "用一句话帮我记住它。",
          "timestamp": "2026-04-09T20:33:00+08:00"
        },
        {
          "role": "assistant",
          "text": "一句话：不同调度目标对应不同指标与策略。",
          "timestamp": "2026-04-09T20:36:00+08:00"
        },
        {
          "role": "user",
          "text": "它和哪个知识点最容易混淆？",
          "timestamp": "2026-04-09T20:37:00+08:00"
        },
        {
          "role": "assistant",
          "text": "最容易混淆的是「优先级反转」。区分时先问：讨论的是存储结构、执行过程还是评价指标？",
          "timestamp": "2026-04-09T20:41:00+08:00"
        },
        {
          "role": "user",
          "text": "如果放到真实项目里，这个知识点的价值在哪？",
          "timestamp": "2026-04-09T20:42:00+08:00"
        },
        {
          "role": "assistant",
          "text": "操作系统实验里常用 RR 模拟交互式终端。",
          "timestamp": "2026-04-09T20:44:00+08:00"
        }
      ]
    }
