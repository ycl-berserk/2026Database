{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Learning Space",
  "version": "0.2.0",
  "identifier": "com.learningspace.desktop",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "学习空间",
        "width": 1280,
        "height": 860,
        "minWidth": 390,
        "minHeight": 640,
        "center": true,
        "resizable": true
      },
      {
        "label": "share",
        "title": "手机访问 · 学习空间",
        "url": "share.html",
        "width": 460,
        "height": 640,
        "minWidth": 380,
        "minHeight": 520,
        "center": true,
        "resizable": true,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "resources": ["resources/**/*"],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      },
      "nsis": {
        "installMode": "currentUser",
        "languages": ["SimpChinese", "English"],
        "displayLanguageSelector": false
      }
    }
  }
}
