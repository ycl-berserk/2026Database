# 主应用连接（只读/写业务表，无 DDL 权限）
DATABASE_URL=postgresql://ls_app:ls_app_dev_pw@127.0.0.1:5433/learning_space
# Text2SQL 只读连接（只能 SELECT t2s 视图）
T2S_DATABASE_URL=postgresql://t2s_reader:t2s_dev_pw@127.0.0.1:5433/learning_space
# 初始化/测试库管理连接（仅脚本使用）
ADMIN_DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5433/postgres
TEST_DATABASE_URL=postgresql://ls_app:ls_app_dev_pw@127.0.0.1:5433/learning_space_test

# 会话签名密钥：生产环境必须替换为至少 32 字符的随机值，否则应用拒绝启动
SESSION_SECRET=dev-only-change-me-please-32-chars
APP_ENV=dev
# 会话绝对有效期（秒，默认 7 天）；生产环境自动启用 Secure Cookie 与 HSTS
SESSION_MAX_AGE=604800
# 登录限流：IP+账号失败次数 / 单 IP 失败次数 / 统计窗口（秒）
LOGIN_MAX_ATTEMPTS=5
LOGIN_IP_MAX_ATTEMPTS=20
LOGIN_WINDOW_SECONDS=900

# Text2SQL：auto = 有 Key 用真实 API，否则本地规则 mock
TEXT2SQL_MODE=auto
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=
LLM_MODEL=deepseek-chat

# 混合检索：auto = 配置 EMBEDDING_API_KEY 时启用，否则退回词法检索
# EMBEDDING_BASE_URL / EMBEDDING_API_KEY 未填时沿用上面的 LLM_BASE_URL / LLM_API_KEY
EMBEDDING_MODE=auto
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIM=1536
HYBRID_SEARCH=1

# 会话整理建议（摘要 + 标签）：auto = 有 LLM Key 才显示按钮，off 可强制关闭
SUGGEST_MODE=auto

# 复习调度：fsrs = FSRS 风格长程记忆调度，simple = 旧的间隔翻倍（降级路径）
REVIEW_ALGORITHM=fsrs
# FSRS 目标记忆保持率，范围 0.7–0.98；0.9 时下次间隔约等于稳定性
REVIEW_RETENTION=0.9

# 执行计划预检：设为 0/false/off 可关闭
TEXT2SQL_PREFLIGHT=1
TEXT2SQL_MAX_COST=500000
TEXT2SQL_MAX_EST_ROWS=200000
